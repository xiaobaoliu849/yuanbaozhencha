# 元宝搜索 API Key（腾讯云控制台 → 元宝搜索 → API KEY）
YUANBAO_API_KEY=
# 大模型（OpenAI 兼容接口，如 Toklens 的 DeepSeek / GLM）
LLM_API_KEY=
LLM_BASE_URL=https://hkg.toklens.ai/v1
# 不填就自动选接口里第一个 DeepSeek 模型；可用模型见 http://localhost:8000/api/models
LLM_MODEL=
# 截图识别：填了 GEMINI_API_KEY 就用 Gemini 看图；或者填一个能看图的模型名
GEMINI_API_KEY=
LLM_VISION_MODEL=
# Optional
# PUBLIC_URL=https://your-app.example.com
# CRON_TOKEN=any-random-string
# WATCH_INTERVAL_HOURS=24
# DAILY_LIMIT=40
# ALERT_WEBHOOK_URL=
# GEMINI_TEXT_MODEL=gemini-3.5-flash
# YUANBAO_EXTRA={"Cnt": 10}
